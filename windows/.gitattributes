# Normalize text files to LF (recommended for Flutter/Dart)
* text=auto eol=lf

# Treat common binary types correctly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.a binary
*.so binary
*.dll binary
*.exe binary
*.pdf binary

# Dart files should always use LF
*.dart text eol=lf

# Generated files (some generated by Flutter build process)
*.g.dart text eol=lf
*.freezed.dart text eol=lf

# iOS project settings (Xcode prefers LF)
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.xcworkspacedata text eol=lf

# Android Gradle scripts (LF works everywhere)
*.gradle text eol=lf
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf

# Batch scripts (Windows)
*.bat text eol=crlf

# gitignore should always use LF
.gitignore text eol=lf
